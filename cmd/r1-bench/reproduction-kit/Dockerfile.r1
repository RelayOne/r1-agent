# syntax=docker/dockerfile:1.7
#
# Reproduction-kit Dockerfile for R1's own dispatcher. Two-stage build
# pinned to Go 1.25; runtime stage runs r1-bench against the embedded
# golden corpus.

FROM golang:1.25-alpine AS builder
WORKDIR /src
COPY . .
RUN go build -trimpath -o /out/r1-bench ./cmd/r1-bench

FROM alpine:3.20 AS runtime
LABEL r1.bench.agent="r1"
RUN apk add --no-cache git bash
COPY --from=builder /out/r1-bench /usr/local/bin/r1-bench
COPY internal/bench/golden /opt/r1/golden
WORKDIR /workspace
ENTRYPOINT ["/usr/local/bin/r1-bench"]
