@@ -0,0 +1,38 @@
+package http
+
+import (
+	"encoding/json"
+	"errors"
+	"net/http"
+)
+
+// ErrInvalidJSON is returned when a request body fails to parse as JSON.
+var ErrInvalidJSON = errors.New("invalid JSON body")
+
+// RequireJSONBody wraps next, returning 400 when the request body is
+// not valid JSON or the Content-Type is not application/json.
+func RequireJSONBody(next http.HandlerFunc) http.HandlerFunc {
+	return func(w http.ResponseWriter, r *http.Request) {
+		if r.Header.Get("Content-Type") != "application/json" {
+			http.Error(w, ErrInvalidJSON.Error(), http.StatusBadRequest)
+			return
+		}
+		var dummy map[string]any
+		dec := json.NewDecoder(r.Body)
+		if err := dec.Decode(&dummy); err != nil {
+			http.Error(w, ErrInvalidJSON.Error(), http.StatusBadRequest)
+			return
+		}
+		next(w, r)
+	}
+}
