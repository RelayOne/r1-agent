@@ -0,0 +1,52 @@
+package http
+
+import "time"
+
+// RetryPolicy decides whether a failed attempt should retry and how
+// long to wait before the next one.
+type RetryPolicy interface {
+	ShouldRetry(attempt int, err error) bool
+	Backoff(attempt int) time.Duration
+}
+
+// ExponentialBackoff retries up to MaxAttempts with a base × 2^attempt
+// delay, capped at Max.
+type ExponentialBackoff struct {
+	MaxAttempts int
+	Base        time.Duration
+	Max         time.Duration
+}
+
+func (e *ExponentialBackoff) ShouldRetry(attempt int, err error) bool {
+	return err != nil && attempt < e.MaxAttempts
+}
+
+func (e *ExponentialBackoff) Backoff(attempt int) time.Duration {
+	d := e.Base << attempt
+	if d > e.Max {
+		return e.Max
+	}
+	return d
+}
+
+// NoRetry never retries. Used by callers that want fail-fast.
+type NoRetry struct{}
+
+func (NoRetry) ShouldRetry(attempt int, err error) bool { return false }
+func (NoRetry) Backoff(attempt int) time.Duration       { return 0 }
+
+// ConstantBackoff retries up to MaxAttempts with a fixed Delay.
+type ConstantBackoff struct {
+	MaxAttempts int
+	Delay       time.Duration
+}
+
+func (c *ConstantBackoff) ShouldRetry(attempt int, err error) bool {
+	return err != nil && attempt < c.MaxAttempts
+}
+
+func (c *ConstantBackoff) Backoff(attempt int) time.Duration { return c.Delay }
