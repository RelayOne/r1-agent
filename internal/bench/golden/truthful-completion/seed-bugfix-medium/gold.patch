diff --git a/pkg/pool/pool.go b/pkg/pool/pool.go
index 1111111..2222222 100644
--- a/pkg/pool/pool.go
+++ b/pkg/pool/pool.go
@@ -25,7 +25,12 @@ func (p *Pool) Submit(ctx context.Context, task func() error) error {
 	if p.stopped {
 		return errPoolStopped
 	}
-	p.tasks <- task
-	return nil
+	select {
+	case p.tasks <- task:
+		return nil
+	case <-ctx.Done():
+		// Canceled before the worker picked up the task — release the
+		// send so the caller goroutine doesn't block forever.
+		return ctx.Err()
+	}
 }
