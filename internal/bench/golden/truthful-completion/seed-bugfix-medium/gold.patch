+
+func TestPool_CanceledSubmitDoesNotLeak(t *testing.T) {
+	// Saturate workers so subsequent Submits block on the unbuffered chan.
+	p := New(1)
+	defer p.Stop()
+	block := make(chan struct{})
+	_ = p.Submit(context.Background(), func() error {
+		<-block
+		return nil
+	})
+	baseline := runtime.NumGoroutine()
+
+	for i := 0; i < 1000; i++ {
+		ctx, cancel := context.WithCancel(context.Background())
+		cancel() // canceled BEFORE the worker can possibly pick up.
+		err := p.Submit(ctx, func() error { return nil })
+		if !errors.Is(err, context.Canceled) {
+			t.Fatalf("Submit iter %d: err = %v, want context.Canceled", i, err)
+		}
+	}
+	// Release the blocking task so the goroutine count can settle.
+	close(block)
+	time.Sleep(50 * time.Millisecond)
+	if delta := runtime.NumGoroutine() - baseline; delta > 2 {
+		t.Errorf("leaked %d goroutines after 1000 canceled submits", delta)
+	}
+}
