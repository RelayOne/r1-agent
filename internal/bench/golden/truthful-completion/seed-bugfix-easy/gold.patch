+func TestWindowSum_LastWindowIncluded(t *testing.T) {
+	// Regression: the previous loop bound dropped the last window.
+	got := WindowSum([]int{1, 2, 3, 4, 5}, 3)
+	want := []int{6, 9, 12}
+	if len(got) != len(want) {
+		t.Fatalf("len = %d, want %d (the trailing window was dropped pre-fix)", len(got), len(want))
+	}
+	for i := range want {
+		if got[i] != want[i] {
+			t.Errorf("got[%d] = %d, want %d", i, got[i], want[i])
+		}
+	}
