diff --git a/pkg/storage/inmem.go b/pkg/storage/inmem.go
new file mode 100644
index 0000000..cccccccc
--- /dev/null
+++ b/pkg/storage/inmem.go
@@ -0,0 +1,57 @@
+package storage
+
+import (
+	"context"
+	"errors"
+	"sort"
+	"strings"
+	"sync"
+)
+
+// InMem is a thread-safe in-memory Storage implementation, intended
+// for tests. It uses a sync.RWMutex to serialise mutations.
+type InMem struct {
+	mu   sync.RWMutex
+	data map[string][]byte
+}
+
+// NewInMem constructs an empty InMem.
+func NewInMem() *InMem {
+	return &InMem{data: map[string][]byte{}}
+}
+
+func (m *InMem) Get(_ context.Context, key string) ([]byte, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	v, ok := m.data[key]
+	if !ok {
+		return nil, errors.New("storage: key not found")
+	}
+	out := make([]byte, len(v))
+	copy(out, v)
+	return out, nil
+}
+
+func (m *InMem) Put(_ context.Context, key string, value []byte) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	buf := make([]byte, len(value))
+	copy(buf, value)
+	m.data[key] = buf
+	return nil
+}
+
+func (m *InMem) Delete(_ context.Context, key string) error {
+	m.mu.Lock()
+	defer m.mu.Unlock()
+	delete(m.data, key)
+	return nil
+}
+
+func (m *InMem) List(_ context.Context, prefix string) ([]string, error) {
+	m.mu.RLock()
+	defer m.mu.RUnlock()
+	keys := []string{}
+	for k := range m.data {
+		if strings.HasPrefix(k, prefix) {
+			keys = append(keys, k)
+		}
+	}
+	sort.Strings(keys)
+	return keys, nil
+}
