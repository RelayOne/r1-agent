+++ b/pkg/storage/inmem_test.go
@@ -0,0 +1,32 @@
+package storage
+
+import (
+	"context"
+	"testing"
+)
+
+// Compile-time check that InMem satisfies Storage.
+var _ Storage = (*InMem)(nil)
+
+func TestInMem_PutGet(t *testing.T) {
+	m := NewInMem()
+	ctx := context.Background()
+	if err := m.Put(ctx, "k", []byte("v")); err != nil {
+		t.Fatalf("Put: %v", err)
+	}
+	got, err := m.Get(ctx, "k")
+	if err != nil {
+		t.Fatalf("Get: %v", err)
+	}
+	if string(got) != "v" {
+		t.Errorf("Get = %q, want v", got)
+	}
+	// Get returns a defensive copy — mutating doesn't affect the store.
+	got[0] = 'x'
+	got2, _ := m.Get(ctx, "k")
+	if string(got2) != "v" {
+		t.Errorf("store should defensive-copy on Get; got %q", got2)
+	}
+}
