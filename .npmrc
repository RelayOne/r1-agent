# SPDX-License-Identifier: MIT
# Prevent npm workspace hoisting. The web/ workspace declares its own
# `vite` dep; without this, npm install --workspaces hoists vite to
# the repo root AND also keeps a copy in web/node_modules. tsc then
# sees two structurally-identical-but-nominally-distinct Plugin types
# from the two vite copies and fails with TS2769 on
# `plugins: [react()]` in vite.config.ts.
#
# install-strategy=shallow makes npm install each workspace's deps
# only in that workspace's node_modules, no hoisting.
install-strategy=shallow
